PORT=3001

# Scalekit environment URL — from your Scalekit dashboard
SK_ENV_URL=https://your-env.scalekit.dev
SK_CLIENT_ID=your_scalekit_client_id

# The resource URL as registered in Scalekit dashboard (used for `aud` claim validation)
MCP_SERVER_ID=http://localhost:3001

# Paste the minified JSON from Scalekit dashboard → MCP Server → "Protected Resource Metadata"
PROTECTED_RESOURCE_METADATA={"authorization_servers":["https://your-env.scalekit.dev/resources/res_xxx"],"bearer_methods_supported":["header"],"resource":"http://localhost:3001","scopes_supported":[]}
